{
  "kind": "day_resolution",
  "suites": [
    "php"
  ],
  "description": "Business date from occurred_at via the user's calendar history (timezone + day_start_offset, A22). Spec 08, amendments 0.2, A5.",
  "rules": {
    "future_tolerance_seconds": 300,
    "max_offline_age_seconds": 7776000,
    "max_backdate_days": 30,
    "day_start": "first instant whose wall clock shows 00:00 + day_start_offset; inside a DST gap, the transition instant",
    "event_date": "latest local date whose start is at or before the event, using the calendar entry effective at occurred_at (the first entry governs earlier instants, A26/R1)",
    "period_boundaries": "a date's start uses the latest calendar entry effective at or before that start"
  },
