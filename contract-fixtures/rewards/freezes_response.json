{
  "description": "A41 / A42 / A43: GET /freezes?limit&cursor. cap is 2; next_refill_on is the first day of the user's next local month; policy is the latest 20 opt-in versions, newest first; the ledger is newest first, keyset on (created_at, id), with habit_id and period_key null for grants. limit default 20, max 50; a bad cursor is 422. Owner-scoped. Read-only.",
  "suites": [
    "php",
    "dart"
  ],
  "response": {
    "data": {
      "freeze_balance": 1,
      "cap": 2,
      "auto_freeze": true,
      "next_refill_on": "{{date}}",
      "policy": [
        {
          "enabled": true,
          "effective_at": "{{time}}"
        }
      ],
      "ledger": [
        {
          "id": "{{uuid}}",
          "kind": "spend",
          "delta": -1,
          "reason": "missed_period",
          "habit_id": "{{uuid}}",
          "period_key": "d:2026-05-27",
          "created_at": "{{time}}"
        },
        {
          "id": "{{uuid}}",
          "kind": "grant",
          "delta": 2,
          "reason": "signup",
          "habit_id": null,
          "period_key": null,
          "created_at": "{{time}}"
        }
      ],
      "next_cursor": "{{cursor_or_null}}"
    }
  },
  "kinds": {
    "grant": [
      "signup",
      "monthly",
      "cap_reached"
    ],
    "spend": [
      "missed_period"
    ],
    "refund": [
      "late_completion",
      "cap_reached"
    ]
  }
}
