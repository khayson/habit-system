{
  "description": "Phase 4.1 (A34): habit.update, habit.archive and habit.restore through /sync. Each case creates its habit on 2026-05-01 (habit.create, backdate), then runs its steps in order with the server clock at `now` (the user's calendar: America/Los_Angeles, day start 00:00). A step sends one mutation (base_version as given; `null` keeps the habit's current version) and checks the ack and, where given, the canonical habit afterwards. Today is Thursday 2026-05-28: tomorrow is 2026-05-29, next Monday 2026-06-01. Definition rows list version, effective_date and the fields that differ from the habit as created.",
  "suites": [
    "php",
    "dart"
  ],
  "now": "2026-05-28T17:22:00Z",
  "cases": [
    {
      "name": "update the name only",
      "habit": {"type": "binary", "target_value": 1, "unit": null, "category": "health", "frequency_type": "daily", "frequency_config": {}},
      "steps": [
        {
          "operation": "habit.update",
          "base_version": 1,
          "payload": {"name": "Morning stretch"},
          "expect": {"status": "accepted", "version": 2},
          "habit": {"name": "Morning stretch", "definitions": [{"version": 1, "effective_date": "2026-05-01"}]}
        }
      ]
    },
    {
      "name": "update the target: a pending version from tomorrow",
      "habit": {"type": "quantity", "target_value": "2000.000", "unit": "ml", "category": "health", "frequency_type": "daily", "frequency_config": {}},
      "steps": [
        {
          "operation": "habit.update",
          "base_version": 1,
          "payload": {"target_value": "2500.000"},
          "expect": {"status": "accepted", "version": 2},
          "habit": {
            "target_value": "2500.000",
            "definitions": [
              {"version": 1, "effective_date": "2026-05-01", "target_value": "2000.000"},
              {"version": 2, "effective_date": "2026-05-29", "target_value": "2500.000"}
            ]
          }
        }
      ]
    },
    {
      "name": "a second update the same day replaces the pending version in place",
      "habit": {"type": "quantity", "target_value": "2000.000", "unit": "ml", "category": "health", "frequency_type": "daily", "frequency_config": {}},
      "steps": [
        {"operation": "habit.update", "base_version": 1, "payload": {"target_value": "2500.000"}, "expect": {"status": "accepted", "version": 2}},
        {
          "operation": "habit.update",
          "base_version": 2,
          "payload": {"target_value": "3000.000", "unit": "ml"},
          "expect": {"status": "accepted", "version": 3},
          "habit": {
            "target_value": "3000.000",
            "definitions": [
              {"version": 1, "effective_date": "2026-05-01", "target_value": "2000.000"},
              {"version": 2, "effective_date": "2026-05-29", "target_value": "3000.000"}
            ]
          }
        }
      ]
    },
    {
      "name": "updating back to the version in force removes the pending version",
      "habit": {"type": "quantity", "target_value": "2000.000", "unit": "ml", "category": "health", "frequency_type": "daily", "frequency_config": {}},
      "steps": [
        {"operation": "habit.update", "base_version": 1, "payload": {"target_value": "2500.000"}, "expect": {"status": "accepted", "version": 2}},
        {
          "operation": "habit.update",
          "base_version": 2,
          "payload": {"target_value": "2000.000"},
          "expect": {"status": "accepted", "version": 3},
          "habit": {"target_value": "2000.000", "definitions": [{"version": 1, "effective_date": "2026-05-01", "target_value": "2000.000"}]}
        }
      ]
    },
    {
      "name": "a weekly schedule change starts next Monday",
      "habit": {"type": "binary", "target_value": 1, "unit": null, "category": "health", "frequency_type": "daily", "frequency_config": {}},
      "steps": [
        {
          "operation": "habit.update",
          "base_version": 1,
          "payload": {"frequency_type": "weekly_count", "frequency_config": {"count": 3}},
          "expect": {"status": "accepted", "version": 2},
          "habit": {
            "frequency_type": "weekly_count",
            "definitions": [
              {"version": 1, "effective_date": "2026-05-01", "frequency_type": "daily"},
              {"version": 2, "effective_date": "2026-06-01", "frequency_type": "weekly_count"}
            ]
          }
        }
      ]
    },
    {
      "name": "an interval habit changes on its next scheduled day",
      "habit": {"type": "binary", "target_value": 1, "unit": null, "category": "health", "frequency_type": "interval", "frequency_config": {"every_n_days": 3, "anchor_date": "2026-05-01"}},
      "steps": [
        {
          "operation": "habit.update",
          "base_version": 1,
          "payload": {"category": "mindfulness"},
          "expect": {"status": "accepted", "version": 2},
          "habit": {
            "category": "mindfulness",
            "definitions": [
              {"version": 1, "effective_date": "2026-05-01", "category": "health"},
              {"version": 2, "effective_date": "2026-05-31", "category": "mindfulness"}
            ]
          }
        }
      ]
    },
    {
      "name": "a stale base version is a conflict carrying the canonical habit",
      "habit": {"type": "binary", "target_value": 1, "unit": null, "category": "health", "frequency_type": "daily", "frequency_config": {}},
      "steps": [
        {"operation": "habit.update", "base_version": 1, "payload": {"name": "Stretch daily"}, "expect": {"status": "accepted", "version": 2}},
        {
          "operation": "habit.update",
          "base_version": 1,
          "payload": {"name": "Stretch in the morning"},
          "expect": {"status": "conflict", "error_code": "version_conflict", "current_version": 2, "current_name": "Stretch daily"}
        }
      ]
    },
    {
      "name": "an identical update is acknowledged without a new version",
      "habit": {"type": "binary", "target_value": 1, "unit": null, "category": "health", "frequency_type": "daily", "frequency_config": {}},
      "steps": [
        {"operation": "habit.update", "base_version": 1, "payload": {}, "expect": {"status": "accepted", "version": 1, "journaled": false}}
      ]
    },
    {
      "name": "the type cannot change",
      "habit": {"type": "binary", "target_value": 1, "unit": null, "category": "health", "frequency_type": "daily", "frequency_config": {}},
      "steps": [
        {"operation": "habit.update", "base_version": 1, "payload": {"type": "quantity"}, "expect": {"status": "rejected", "error_code": "invalid_value"}}
      ]
    },
    {
      "name": "archive closes the range at the start of tomorrow; today stays valid",
      "habit": {"type": "binary", "target_value": 1, "unit": null, "category": "health", "frequency_type": "daily", "frequency_config": {}},
      "steps": [
        {
          "operation": "habit.archive",
          "base_version": 1,
          "payload": {},
          "expect": {"status": "accepted", "version": 2},
          "habit": {"archived": true, "active_ranges": [["2026-05-01", "2026-05-29"]]}
        },
        {"operation": "habit.archive", "base_version": 2, "payload": {}, "expect": {"status": "accepted", "version": 2, "journaled": false}},
        {"operation": "log.set_value", "base_version": 0, "payload": {"value": 1}, "expect": {"status": "rejected", "error_code": "habit_archived"}},
        {"operation": "habit.update", "base_version": 2, "payload": {"name": "Renamed"}, "expect": {"status": "rejected", "error_code": "habit_archived"}}
      ]
    },
    {
      "name": "restore on the same day continues from tomorrow, with no overlap",
      "habit": {"type": "binary", "target_value": 1, "unit": null, "category": "health", "frequency_type": "daily", "frequency_config": {}},
      "steps": [
        {"operation": "habit.archive", "base_version": 1, "payload": {}, "expect": {"status": "accepted", "version": 2}},
        {
          "operation": "habit.restore",
          "base_version": 2,
          "payload": {},
          "expect": {"status": "accepted", "version": 3},
          "habit": {"archived": false, "active_ranges": [["2026-05-01", "2026-05-29"], ["2026-05-29", null]]}
        },
        {"operation": "habit.restore", "base_version": 3, "payload": {}, "expect": {"status": "accepted", "version": 3, "journaled": false}},
        {
          "operation": "habit.archive",
          "base_version": 3,
          "payload": {},
          "expect": {"status": "accepted", "version": 4},
          "habit": {"archived": true, "active_ranges": [["2026-05-01", "2026-05-29"]]}
        }
      ]
    },
    {
      "name": "restore on a later day opens a new range from that day; the gap stays excluded",
      "habit": {"type": "binary", "target_value": 1, "unit": null, "category": "health", "frequency_type": "daily", "frequency_config": {}},
      "steps": [
        {"operation": "habit.archive", "base_version": 1, "payload": {}, "expect": {"status": "accepted", "version": 2}},
        {
          "now": "2026-06-03T17:22:00Z",
          "operation": "habit.restore",
          "base_version": 2,
          "payload": {},
          "expect": {"status": "accepted", "version": 3},
          "habit": {"archived": false, "active_ranges": [["2026-05-01", "2026-05-29"], ["2026-06-03", null]]}
        }
      ]
    }
  ],
  "rules": [
    "habit.update carries the whole editable state {name, category, target_value, unit, frequency_type, frequency_config, icon (A53)}; a case's payload lists only the fields it changes and the test fills the rest from the habit as it stands",
    "the name applies at once; category, target, unit and frequency are a new definition version effective from nextEffectiveDate at apply time, replaced in place while pending, removed when the desired state equals the version in force",
    "restoring on the archive day opens a range from tomorrow (max(today, previous end)): adjacent, no overlap, no gap; archiving again before that range starts removes it (ASSUMPTION(A34-empty-range): a range cannot end where it starts)",
    "every rejected and conflicting step writes nothing and journals nothing"
  ]
}
