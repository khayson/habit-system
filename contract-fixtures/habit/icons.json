  "mutations": {
    "create_with_icon": {
      "payload_icon": "book-open-01",
      "expect": {
        "status": "accepted",
        "version": 1,
        "icon": "book-open-01"
      }
    },
    "create_without_icon": {
      "expect": {
        "status": "accepted",
        "version": 1,
        "icon": null
      }
    },
    "update_icon_only": {
      "from": "book-02",
      "payload_icon": "book-open-01",
      "expect": {
        "status": "accepted",
        "version": 2,
        "definition_version": 1,
        "definitions": 1,
        "icon": "book-open-01"
      }
    },
    "update_icon_absent_keeps": {
      "from": "book-02",
      "payload_name": "Evening reading",
      "expect": {
        "status": "accepted",
        "version": 2,
        "icon": "book-02"
      }
    },
    "update_icon_null_clears": {
      "from": "book-02",
      "payload_icon": null,
      "expect": {
        "status": "accepted",
        "version": 2,
        "icon": null
      }
    },
    "update_same_icon_noop": {
      "from": "book-02",
      "payload_icon": "book-02",
      "expect": {
        "status": "accepted",
        "version": 1,
        "journaled": false
      }
    },
    "invalid": {
      "expect": {
        "status": "rejected",
        "error_code": "validation_failed",
        "field": "icon"
      }
    }
  },
  "rules": [
    "habit entity (pull, bootstrap, export) always carries icon: a key or null",
    "an icon change never adds a definition version and never changes definition_version",
    "habit.update without the icon field leaves the icon unchanged (apps from before A53)",
    "backfill: existing habits with a null icon get the keyword table's icon for their name; a chosen icon is never overwritten"
  ]
}
