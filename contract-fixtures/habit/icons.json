{
  "description": "A53: a habit's icon. The key is a free Hugeicons stroke-rounded name in kebab form (the app bundles all 6,063 of hugeicons 1.2.0 and searches them); the server checks the shape only. Category defaults for a null or unknown key, the keyword table the app's name suggestion and the server's one-time backfill share, the featured icons the picker shows first, and the habit.create / habit.update wire cases.",
  "suites": [
    "php",
    "dart"
  ],
  "now": "2026-05-28T17:22:00Z",
  "key_pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
  "max_length": 64,
  "valid_keys": [
    "book-02",
    "glass-water",
    "1st-bracket",
    "music-3",
    "3-d-view"
  ],
  "invalid_keys": [
    "Book-02",
    "book_02",
    "book 02",
    "-book",
    "book-",
    "book--02",
    "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    123,
    true,
    [
      "book-02"
    ]
  ],
  "category_defaults": {
    "health": "heart-check",
    "mindfulness": "yoga-03",
