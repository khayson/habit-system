APP_NAME="Habit System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=habit
DB_USERNAME=habit
DB_PASSWORD=habit

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# A48: export manifest signing, kid:secret pairs (comma-separated) and the current kid.
# Set per environment; never commit a real secret. Outside local and testing, /health answers 503
# when the current kid's secret is the published test secret or shorter than 32 bytes.
EXPORT_SIGNING_KEYS=
EXPORT_SIGNING_KID=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# A50: local development writes mail to the log. Production sets MAIL_MAILER=smtp and the rest in
# the host's environment only; Brevo's relay is smtp-relay.brevo.com on port 587. Never commit
# the SMTP key.
MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Rate limits (config/api.php). Defaults shown.
# RATE_LIMIT_API_PER_MINUTE=120
# RATE_LIMIT_AUTH_PER_MINUTE_PER_IP=20
# RATE_LIMIT_AUTH_PER_MINUTE_PER_EMAIL=5
# RATE_LIMIT_PASSWORD_RESET_PER_HOUR_PER_IP=20
# RATE_LIMIT_PASSWORD_RESET_PER_HOUR_PER_EMAIL=5
# RATE_LIMIT_SYNC_PER_MINUTE=60
# RATE_LIMIT_AVATAR_UPLOADS_PER_HOUR=10
